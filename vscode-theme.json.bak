{
    "name": "Omarchy",
    "$schema": "vscode://schemas/color-theme",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "parameter": "#BAC8B1",
        "parameter.declaration": "#BAC8B1",
        "variable": "#BAC8B1",
        "variable.declaration": "#BAC8B1",
        "variable.readonly": "#BAC8B1",
        "variable.defaultLibrary": "#BAC8B1",
        "property": "#BAC8B1",
        "property.declaration": "#BAC8B1",
        "property.readonly": "#BAC8B1",
        "function": "#4D5F64",
        "function.declaration": "#4D5F64",
        "function.defaultLibrary": "#BAC8B1",
        "method": "#4D5F64",
        "method.declaration": "#4D5F64",
        "class": "#BAC8B1",
        "class.declaration": "#BAC8B1",
        "class.defaultLibrary": "#BAC8B1",
        "interface": "#BAC8B1",
        "interface.declaration": "#BAC8B1",
        "enum": "#BAC8B1",
        "enumMember": "#BAC8B1",
        "type": "#BAC8B1",
        "type.declaration": "#BAC8B1",
        "type.defaultLibrary": "#BAC8B1",
        "typeParameter": "#BAC8B1",
        "namespace": "#4D5F64",
        "macro": "#BAC8B1",
        "decorator": "#4D5F64",
        "string": "#BAC8B1",
        "number": "#BAC8B1",
        "boolean": "#BAC8B1",
        "regexp": "#ff85b3",
        "operator": "#BAC8B1",
        "keyword": "#4D5F64",
        "comment": {"foreground": "#BAC8B1", "fontStyle": "italic"},
        "comment.documentation": {"foreground": "#BAC8B1", "fontStyle": "italic"}
    },
    "colors": {
        "foreground": "#BAC8B1",
        "disabledForeground": "#BAC8B1",
