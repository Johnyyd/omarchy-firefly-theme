@define-color background #2a2a26;
@define-color foreground #fbc6c8;
@define-color border alpha(@foreground, 0.3);
@define-color accent #bf3533;
@define-color panel-tint rgba(139, 199, 195, 0.05);
@define-color panel alpha(@background, 0.9);

window#waybar {
    background: transparent;
    color: @foreground;
}

.modules-left,
.modules-center,
.modules-right {
    margin: 6px 8px 0;
    padding: 2px 6px;
    background: linear-gradient(to bottom, @panel-tint, @panel);
    border: 1px solid @border;
    border-radius: 12px;
}

#workspaces button.active,
#workspaces button.focused,
#custom-launcher,
#window {
    color: @accent;
}